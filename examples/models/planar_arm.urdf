<?xml version="1.0"?>
<!-- Kinematic fixture only: inertial and collision data intentionally absent. -->
<robot name="wholebodyx_planar_arm">
  <link name="base"/><link name="upper_arm"/><link name="forearm"/>
  <link name="wrist"/><link name="tool"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/><child link="upper_arm"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" velocity="1" effort="10"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/><child link="forearm"/><origin xyz="0.4 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" velocity="1" effort="10"/>
  </joint>
  <joint name="wrist_joint" type="revolute">
    <parent link="forearm"/><child link="wrist"/><origin xyz="0.3 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.8" upper="2.8" velocity="1" effort="10"/>
  </joint>
  <joint name="tool_mount" type="fixed">
    <parent link="wrist"/><child link="tool"/><origin xyz="0.2 0 0"/>
  </joint>
</robot>
